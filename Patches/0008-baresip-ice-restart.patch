 };
@@ -63,6 +65,8 @@ struct mnat_media {
 		struct turnc *turnc;
 		struct udp_helper *uh;
 		struct mbuf *mb;
+		struct sa relay;
+		struct sa mapped;
 	} compv[2];
 	struct le le;
 	struct mnat_sess *sess;
@@ -147,6 +151,8 @@ static void stun_resp_handler(int err, uint16_t scode, const char *reason,
 	err = icem_lcand_add(m->icem, icem_lcand_base(lcand),
 			     ICE_CAND_TYPE_SRFLX,
 			     &attr->v.sa);
+	if (!err)
+		comp->mapped = attr->v.sa;
 
  out:
 	call_gather_handler(err, m, scode, reason);
@@ -215,6 +221,10 @@ static void turnc_handler(int err, uint16_t scode, const char *reason,
 	debug("ice: relay gathered for comp %u (%u %s)\n",
 	      comp->id, scode, reason);
 
