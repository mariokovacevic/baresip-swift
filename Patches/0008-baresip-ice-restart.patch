index 85e8ccc..752e656 100644
--- a/include/baresip.h
+++ b/include/baresip.h
@@ -249,6 +249,7 @@ bool call_has_audio(const struct call *call);
 bool call_has_video(const struct call *call);
 bool call_early_video_available(const struct call *call);
 bool call_refresh_allowed(const struct call *call);
+int  call_restart_mnat(struct call *call);
 bool call_ack_pending(const struct call *call);
 bool call_sess_cmp(const struct call *call, const struct sip_msg *msg);
 int  call_transfer(struct call *call, const char *uri);
@@ -1687,6 +1688,8 @@ typedef int (mnat_media_h)(struct mnat_media **mp, struct mnat_sess *sess,
 
 typedef int (mnat_update_h)(struct mnat_sess *sess);
 
+typedef int (mnat_restart_h)(struct mnat_sess *sess);
+
 typedef void (mnat_attr_h)(struct mnat_media *mm,
 			   const char *name, const char *value);
 
@@ -1699,6 +1702,7 @@ struct mnat {
 	mnat_media_h *mediah;
 	mnat_update_h *updateh;
 	mnat_attr_h *attrh;
+	mnat_restart_h *restarth;
 };
 
 void mnat_register(struct list *mnatl, struct mnat *mnat);
diff --git a/modules/ice/ice.c b/modules/ice/ice.c
index 564bfb8..042026e 100644
--- a/modules/ice/ice.c
+++ b/modules/ice/ice.c
@@ -21,7 +21,8 @@
 enum {
 	ICE_LAYER = 0,
 	LPREF_INIT = UINT16_MAX / 2,
-	TCP_GATHER_TIMEOUT = 10000  /* connect, TLS and allocation [ms] */
+	TCP_GATHER_TIMEOUT = 10000, /* connect, TLS and allocation [ms] */
+	RESTART_TIMEOUT = 15000     /* answer with new credentials [ms] */
 };
 
 static struct {
@@ -48,6 +49,13 @@ struct mnat_sess {
 	char *pass;
 	bool started;
 	bool send_reinvite;
+	bool restart_wait;
+	bool restarted;
+	char *rufrag;
+	struct sa laddr;
+	struct tmr tmr_restart;
+	struct tmr tmr_recheck;
+	unsigned recheck;
 	mnat_estab_h *estabh;
 	void *arg;
 };
@@ -66,6 +74,8 @@ struct mnat_media {
 		struct mbuf *mb;
 		struct tmr tmr_tcp;
 		bool tcp_gathering;           /* counted in nstun */
+		struct sa relay;
+		struct sa mapped;
 	} compv[2];
 	struct le le;
 	struct mnat_sess *sess;
@@ -85,6 +95,9 @@ struct mnat_media {
 static void gather_handler(int err, uint16_t scode, const char *reason,
 			   void *arg);
 static bool all_gathered(const struct mnat_sess *sess);
+static void record_laddr(struct mnat_sess *sess);
+static void recheck_handler(void *arg);
+static void restart_timeout_handler(void *arg);
 
 
 static void call_gather_handler(int err, struct mnat_media *m, uint16_t scode,
@@ -152,6 +165,8 @@ static void stun_resp_handler(int err, uint16_t scode, const char *reason,
 	err = icem_lcand_add(m->icem, icem_lcand_base(lcand),
 			     ICE_CAND_TYPE_SRFLX,
 			     &attr->v.sa);
+	if (!err)
+		comp->mapped = attr->v.sa;
 
  out:
 	call_gather_handler(err, m, scode, reason);
@@ -272,6 +287,7 @@ static void turnc_handler(int err, uint16_t scode, const char *reason,
 	/* TURN failed, so we destroy the client */
 	if (err || scode) {
 		icem_set_turn_client(m->icem, comp->id, NULL);
+		comp->turnc = mem_deref(comp->turnc);
 	}
 
 	if (err) {
@@ -292,6 +308,10 @@ static void turnc_handler(int err, uint16_t scode, const char *reason,
 	debug("ice: relay gathered for comp %u (%u %s)\n",
 	      comp->id, scode, reason);
 
+	comp->relay = *relay;
+	if (mapped)
+		comp->mapped = *mapped;
+
 	err = icem_lcand_add_base(m->icem, ICE_CAND_TYPE_RELAY, comp->id, 0,
 				  NULL, ICE_TRANSP_UDP, relay);
 	if (err)
@@ -587,6 +607,9 @@ static int cand_gather_relayed(struct mnat_media *m, struct comp *comp,
 	if (err)
 		goto out;
 
+	mem_deref(comp->turnc);
+	comp->turnc = mem_ref(turnc);
+
 	++m->nstun;
 
  out:
@@ -657,11 +680,14 @@ static void session_destructor(void *arg)
 	struct mnat_sess *sess = arg;
 
 	tmr_cancel(&sess->tmr_async);
+	tmr_cancel(&sess->tmr_restart);
+	tmr_cancel(&sess->tmr_recheck);
 	list_flush(&sess->medial);
 	mem_deref(sess->dnsq);
 	mem_deref(sess->user);
 	mem_deref(sess->pass);
 	mem_deref(sess->host);
+	mem_deref(sess->rufrag);
 	mem_deref(sess->sdp);
 }
 
@@ -805,6 +831,7 @@ static void dns_handler(int err, const struct sa *srv, void *arg)
 	      sess->turn ? "TURN" : "STUN", srv);
 
 	sess->srv = *srv;
+	record_laddr(sess);
 
 	for (le=sess->medial.head; le; le=le->next) {
 
@@ -827,6 +854,8 @@ static void tmr_async_handler(void *arg)
 	struct mnat_sess *sess = arg;
 	struct le *le;
 
+	record_laddr(sess);
+
 	for (le = sess->medial.head; le;) {
 		struct mnat_media *m = le->data;
 		le = le->next;
@@ -1048,6 +1077,11 @@ static void gather_handler(int err, uint16_t scode, const char *reason,
 			err, scode, reason);
 		module_event("ice", "failed", NULL, NULL,
 			     "sdpm=%p err=%m scode=%u", m->sdpm, err, scode);
+
+		/* a failed restart keeps the call, it can be restarted
+		   again */
+		if (m->sess->restart_wait)
+			return;
 	}
 	else {
 		refresh_laddr(m,
@@ -1064,6 +1098,10 @@ static void gather_handler(int err, uint16_t scode, const char *reason,
 
 		if (!all_gathered(m->sess))
 			return;
+
+		if (m->sess->restart_wait)
+			tmr_start(&m->sess->tmr_restart, RESTART_TIMEOUT,
+				  restart_timeout_handler, m->sess);
 	}
 
 	if (err || scode)
@@ -1088,6 +1126,14 @@ static void conncheck_handler(int err, bool update, void *arg)
 
 	ice_printf(m, "Dumping media state: %H\n", icem_debug, m->icem);
 
+	if (err && sess->recheck) {
+		--sess->recheck;
+		info("ice: %s: connectivity check failed after restart (%m),"
+		     " checking again\n", sdp_media_name(m->sdpm), err);
+		tmr_start(&sess->tmr_recheck, 1000, recheck_handler, sess);
+		return;
+	}
+
 	if (err) {
 		warning("ice: connectivity check failed: %m\n", err);
 		module_event("ice", "failed", NULL, NULL, "sdpm=%p err=%m",
@@ -1099,6 +1145,7 @@ static void conncheck_handler(int err, bool update, void *arg)
 		bool changed;
 
 		m->complete = true;
+		sess->recheck = 0;
 
 		lcand = icem_selected_lcand(m->icem, 1);
 		cand1 = icem_selected_rcand(m->icem, 1);
@@ -1112,6 +1159,18 @@ static void conncheck_handler(int err, bool update, void *arg)
 				     icem_lcand_addr(cand1));
 		}
 
+		if (lcand && icem_cand_type(lcand) != ICE_CAND_TYPE_RELAY &&
+		    sess->proto != IPPROTO_TCP) {
+			unsigned i;
+
+			for (i=0; i<2; i++) {
+				struct comp *comp = &m->compv[i];
+
+				comp->turnc = mem_deref(comp->turnc);
+				sa_init(&comp->relay, AF_UNSPEC);
+			}
+		}
+
 		changed = refresh_laddr(m,
 					icem_selected_laddr(m->icem, 1),
 					icem_selected_laddr(m->icem, 2));
@@ -1206,6 +1265,41 @@ static int ice_start(struct mnat_sess *sess)
 }
 
 
+static int media_icem_alloc(struct mnat_media *m, enum ice_role role)
+{
+	struct mnat_sess *sess = m->sess;
+	unsigned i;
+	int err;
+
+	err = icem_alloc(&m->icem, role, IPPROTO_UDP, ICE_LAYER,
+			 sess->tiebrk, sess->lufrag, sess->lpwd,
+			 conncheck_handler, m);
+	if (err)
+		return err;
+
+	icem_conf(m->icem)->debug  = LEVEL_DEBUG == log_level_get();
+	icem_conf(m->icem)->rc	   = 4;
+	icem_conf(m->icem)->policy = sess->proto == IPPROTO_TCP ?
+		ICE_POLICY_RELAY : ice.policy;
+
+	debug("ice: policy = %s\n",
+	      ice.policy == ICE_POLICY_RELAY ? "relay" : "all");
+
+	icem_set_conf(m->icem, icem_conf(m->icem));
+
+	icem_set_name(m->icem, sdp_media_name(m->sdpm));
+
+	for (i=0; i<2; i++) {
+		m->compv[i].m = m;
+		m->compv[i].id = i+1;
+		if (m->compv[i].sock)
+			err |= icem_comp_add(m->icem, i+1, m->compv[i].sock);
+	}
+
+	return err;
+}
+
+
 static int media_alloc(struct mnat_media **mp, struct mnat_sess *sess,
 		       struct udp_sock *sock1, struct udp_sock *sock2,
 		       struct sdp_media *sdpm,
@@ -1213,7 +1307,6 @@ static int media_alloc(struct mnat_media **mp, struct mnat_sess *sess,
 {
 	struct mnat_media *m;
 	enum ice_role role;
-	unsigned i;
 	int err = 0;
 
 	if (!mp || !sess || !sdpm)
@@ -1235,31 +1328,10 @@ static int media_alloc(struct mnat_media **mp, struct mnat_sess *sess,
 	else
 		role = ICE_ROLE_CONTROLLED;
 
-	err = icem_alloc(&m->icem, role, IPPROTO_UDP, ICE_LAYER,
-			 sess->tiebrk, sess->lufrag, sess->lpwd,
-			 conncheck_handler, m);
+	err = media_icem_alloc(m, role);
 	if (err)
 		goto out;
 
-	icem_conf(m->icem)->debug  = LEVEL_DEBUG == log_level_get();
-	icem_conf(m->icem)->rc	   = 4;
-	icem_conf(m->icem)->policy = sess->proto == IPPROTO_TCP ?
-		ICE_POLICY_RELAY : ice.policy;
-
-	debug("ice: policy = %s\n",
-	      ice.policy == ICE_POLICY_RELAY ? "relay" : "all");
-
-	icem_set_conf(m->icem, icem_conf(m->icem));
-
-	icem_set_name(m->icem, sdp_media_name(sdpm));
-
-	for (i=0; i<2; i++) {
-		m->compv[i].m = m;
-		m->compv[i].id = i+1;
-		if (m->compv[i].sock)
-			err |= icem_comp_add(m->icem, i+1, m->compv[i].sock);
-	}
-
 	m->connh = connh;
 	m->arg = arg;
 
@@ -1326,14 +1398,404 @@ static int enable_turn_channels(struct mnat_sess *sess)
 
 
 /** This can be called several times */
+static const struct sa *default_laddr(const struct mnat_sess *sess)
+{
+	const struct sa *laddr = NULL;
+
+	if (sa_isset(&sess->srv, SA_ADDR))
+		laddr = net_laddr_af(baresip_network(), sa_af(&sess->srv));
+
+	if (!laddr || !sa_isset(laddr, SA_ADDR))
+		laddr = net_laddr_af(baresip_network(), AF_INET);
+
+	if (!laddr || !sa_isset(laddr, SA_ADDR))
+		laddr = net_laddr_af(baresip_network(), AF_INET6);
+
+	return laddr && sa_isset(laddr, SA_ADDR) ? laddr : NULL;
+}
+
+
+static void record_laddr(struct mnat_sess *sess)
+{
+	const struct sa *laddr = default_laddr(sess);
+
+	if (laddr)
+		sess->laddr = *laddr;
+}
+
+
+static const char *remote_ufrag(const struct mnat_sess *sess)
+{
+	const char *ufrag = sdp_session_rattr(sess->sdp, ice_attr_ufrag);
+
+	if (!ufrag && sess->medial.head) {
+		const struct mnat_media *m = sess->medial.head->data;
+
+		ufrag = sdp_media_rattr(m->sdpm, ice_attr_ufrag);
+	}
+
+	return ufrag;
+}
+
+
+static int new_credentials(struct mnat_sess *sess)
+{
+	int err;
+
+	rand_str(sess->lufrag, sizeof(sess->lufrag));
+	rand_str(sess->lpwd,   sizeof(sess->lpwd));
+
+	err  = sdp_session_set_lattr(sess->sdp, true,
+				     ice_attr_ufrag, "%s", sess->lufrag);
+	err |= sdp_session_set_lattr(sess->sdp, true,
+				     ice_attr_pwd, "%s", sess->lpwd);
+
+	return err;
+}
+
+
+static int media_reset(struct mnat_media *m, bool keep_gathered)
+{
+	enum ice_role role = icem_local_role(m->icem);
+	unsigned i;
+
+	m->icem = mem_deref(m->icem);
+
+	for (i=0; i<2; i++) {
+		struct comp *comp = &m->compv[i];
+
+		comp->ct_gath = mem_deref(comp->ct_gath);
+
+		if (keep_gathered)
+			continue;
+
+		tcp_conn_close(comp);
+		comp->tcp_gathering = false;
+		comp->uh = mem_deref(comp->uh);
+		sa_init(&comp->laddr, AF_UNSPEC);
+		sa_init(&comp->relay, AF_UNSPEC);
+		sa_init(&comp->mapped, AF_UNSPEC);
+	}
+
+	m->nstun    = 0;
+	m->lpref    = LPREF_INIT;
+	m->complete = false;
+	if (!keep_gathered) {
+		m->gathered = false;
+		m->relay_lost = false;
+	}
+
+	sdp_media_del_lattr(m->sdpm, ice_attr_cand);
+	sdp_media_del_lattr(m->sdpm, ice_attr_remote_cand);
+	sdp_media_del_lattr(m->sdpm, ice_attr_mismatch);
+
+	return media_icem_alloc(m, role);
+}
+
+
+static int media_readd_candidates(struct mnat_media *m)
+{
+	unsigned i;
+	int err = 0;
+
+	net_laddr_apply(baresip_network(), if_handler, m);
+
+	for (i=0; i<2; i++) {
+		struct comp *comp = &m->compv[i];
+		struct ice_cand *lcand;
+
+		if (!comp->sock)
+			continue;
+
+		if (comp->turnc && sa_isset(&comp->relay, SA_ALL)) {
+
+			err |= icem_set_turn_client(m->icem, comp->id,
+						    comp->turnc);
+			err |= icem_lcand_add_base(m->icem,
+						   ICE_CAND_TYPE_RELAY,
+						   comp->id, 0, NULL,
+						   ICE_TRANSP_UDP,
+						   &comp->relay);
+		}
+
+		if (!sa_isset(&comp->mapped, SA_ADDR))
+			continue;
+
+		lcand = icem_cand_find(icem_lcandl(m->icem), comp->id, NULL);
+		if (lcand) {
+			err |= icem_lcand_add(m->icem, icem_lcand_base(lcand),
+					      ICE_CAND_TYPE_SRFLX,
+					      &comp->mapped);
+		}
+	}
+
+	if (err)
+		return err;
+
+	icem_cand_redund_elim(m->icem);
+
+	err = icem_comps_set_default_cand(m->icem);
+	if (err)
+		return err;
+
+	refresh_laddr(m,
+		      icem_cand_default(m->icem, 1),
+		      icem_cand_default(m->icem, 2));
+
+	return set_media_attributes(m);
+}
+
+
+static int restart_regather(struct mnat_sess *sess)
+{
+	struct le *le;
+	int err;
+
+	err = new_credentials(sess);
+	if (err)
+		return err;
+
+	tmr_cancel(&sess->tmr_async);
+	sess->started = false;
+	sess->send_reinvite = false;
+
+	LIST_FOREACH(&sess->medial, le) {
+		err = media_reset(le->data, false);
+		if (err)
+			return err;
+	}
+
+	if (sa_isset(&sess->srv, SA_ALL)) {
+		LIST_FOREACH(&sess->medial, le) {
+			err = media_start(sess, le->data);
+			if (err)
+				return err;
+		}
+	}
+	else if (!sess->host) {
+		LIST_FOREACH(&sess->medial, le) {
+			struct mnat_media *m = le->data;
+
+			module_event("ice", "gathering", NULL, NULL,
+				     "sdpm=%p", m->sdpm);
+		}
+
+		tmr_start(&sess->tmr_async, 1, tmr_async_handler, sess);
+	}
+
+	return 0;
+}
+
+
+static int restart_reuse(struct mnat_sess *sess)
+{
+	struct le *le;
+	int err;
+
+	info("ice: ICE restart, reusing gathered candidates\n");
+
+	err = new_credentials(sess);
+	if (err)
+		return err;
+
+	sess->started = false;
+	sess->send_reinvite = false;
+
+	LIST_FOREACH(&sess->medial, le) {
+		struct mnat_media *m = le->data;
+
+		err = media_reset(m, true);
+		if (err)
+			return err;
+
+		module_event("ice", "gathering", NULL, NULL,
+			     "sdpm=%p", m->sdpm);
+
+		err = media_readd_candidates(m);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
+
+static void restart_failed(struct mnat_sess *sess, int err)
+{
+	struct le *le;
+
+	warning("ice: ICE restart failed: %m\n", err);
+
+	LIST_FOREACH(&sess->medial, le) {
+		struct mnat_media *m = le->data;
+
+		module_event("ice", "failed", NULL, NULL, "sdpm=%p err=%m",
+			     m->sdpm, err);
+	}
+}
+
+
+static void recheck_handler(void *arg)
+{
+	struct mnat_sess *sess = arg;
+	struct le *le;
+	int err = 0;
+
+	LIST_FOREACH(&sess->medial, le) {
+		struct mnat_media *m = le->data;
+
+		err = media_reset(m, true);
+		if (!err)
+			err = media_readd_candidates(m);
+		if (err)
+			break;
+
+		sdp_media_rattr_apply(m->sdpm, NULL, media_attr_handler, m);
+	}
+
+	if (!err) {
+		(void)sdp_session_rattr_apply(sess->sdp, NULL,
+					      sdp_attr_handler, sess);
+		sess->started = false;
+		err = ice_start(sess);
+	}
+
+	if (err)
+		restart_failed(sess, err);
+}
+
+
+static void restart_timeout_handler(void *arg)
+{
+	struct mnat_sess *sess = arg;
+
+	/* the peer did not answer with new credentials, stop waiting */
+	sess->restart_wait = false;
+
+	restart_failed(sess, ETIMEDOUT);
+}
+
+
+static void restart_tmr_handler(void *arg)
+{
+	struct mnat_sess *sess = arg;
+
+	tmr_start(&sess->tmr_restart, RESTART_TIMEOUT,
+		  restart_timeout_handler, sess);
+
+	if (sess->estabh)
+		sess->estabh(0, 0, NULL, sess->arg);
+}
+
+
+static bool reusable(const struct mnat_sess *sess)
+{
+	struct le *le;
+
+	LIST_FOREACH(&sess->medial, le) {
+		const struct mnat_media *m = le->data;
+
+		if (!m->gathered || m->relay_lost)
+			return false;
+	}
+
+	return true;
+}
+
+
+static int restart(struct mnat_sess *sess)
+{
+	const struct sa *laddr;
+	const char *rufrag;
+	int err;
+
+	if (!sess)
+		return EINVAL;
+
+	if (!sess->started && !sess->restarted)
+		return ENOTSUP;
+
+	info("ice: local ICE restart\n");
+
+	tmr_cancel(&sess->tmr_restart);
+	tmr_cancel(&sess->tmr_recheck);
+	sess->recheck = 0;
+
+	rufrag = remote_ufrag(sess);
+	sess->rufrag = mem_deref(sess->rufrag);
+	if (rufrag) {
+		err = str_dup(&sess->rufrag, rufrag);
+		if (err)
+			return err;
+	}
+
+	sess->restart_wait = true;
+	sess->restarted = true;
+
+	laddr = default_laddr(sess);
+
+	if (laddr && sa_cmp(laddr, &sess->laddr, SA_ADDR) &&
+	    reusable(sess)) {
+
+		err = restart_reuse(sess);
+		if (!err) {
+			tmr_start(&sess->tmr_restart, 0, restart_tmr_handler,
+				  sess);
+			return 0;
+		}
+
+		warning("ice: gathered candidates not usable (%m),"
+			" gathering again\n", err);
+	}
+
+	if (laddr)
