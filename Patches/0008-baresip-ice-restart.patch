+	if (mapped)
+		comp->mapped = *mapped;
+
 	err = icem_lcand_add_base(m->icem, ICE_CAND_TYPE_RELAY, comp->id, 0,
 				  NULL, ICE_TRANSP_UDP, relay);
 	if (err)
@@ -518,6 +528,7 @@ static void session_destructor(void *arg)
 	mem_deref(sess->user);
 	mem_deref(sess->pass);
 	mem_deref(sess->host);
