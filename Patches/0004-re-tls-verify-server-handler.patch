+static int tls_verify_server_cb(int ok, X509_STORE_CTX *ctx)
+{
+	SSL *ssl;
+	struct tls_conn *tc;
+	X509 *cert;
+	unsigned char *der = NULL;
+	int len, depth, ret;
+
+	ssl = X509_STORE_CTX_get_ex_data(ctx,
+		SSL_get_ex_data_X509_STORE_CTX_idx());
+	if (!ssl)
+		return ok;
+
+	tc = SSL_get_ex_data(ssl, tls_conn_idx);
+	if (!tc || !tc->tls || !tc->tls->verify_server_h)
+		return ok;
+
+	cert = X509_STORE_CTX_get_current_cert(ctx);
+	depth = X509_STORE_CTX_get_error_depth(ctx);
+	if (!cert)
+		return tc->tls->verify_server_h(ok, depth, NULL, 0,
+						tc->tls->verify_server_arg);
+
+	len = i2d_X509(cert, &der);
+	if (len <= 0 || !der) {
+		ERR_clear_error();
+		return 0;
+	}
+
+	ret = tc->tls->verify_server_h(ok, depth, der, (size_t)len,
+				       tc->tls->verify_server_arg);
+	OPENSSL_free(der);
+
+	return ret;
 }
 
 
