+/**
+ * Set a handler that is consulted for every certificate in the server
+ * chain during TLS client verification. The handler receives OpenSSL's
+ * pre-verification result, the chain depth (0 is the leaf) and the
+ * certificate in DER form, and returns non-zero to accept it.
+ *
+ * @param tls  TLS Context
+ * @param h    Verify handler, NULL to restore the default
+ * @param arg  Handler argument
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int tls_set_verify_server_handler(struct tls *tls, tls_verify_server_h *h,
+				  void *arg)
+{
+	if (!tls)
+		return EINVAL;
+
+	tls->verify_server_h = h;
+	tls->verify_server_arg = arg;
+
+	return 0;
+}
