diff --git a/src/sipreg/reg.c b/src/sipreg/reg.c
index c6f0612..2ebceca 100644
--- a/src/sipreg/reg.c
+++ b/src/sipreg/reg.c
@@ -333,6 +333,9 @@ static int request(struct sipreg *reg, bool reset_ls)
 		sip_loopstate_reset(&reg->ls);
 	}
 
+	/* a request that is still pending is replaced by the new one */
+	reg->req = mem_deref(reg->req);
+
 	return sip_drequestf(&reg->req, reg->sip, true, "REGISTER", reg->dlg,
