diff --git a/src/sipsess/timer.c b/src/sipsess/timer.c
new file mode 100644
index 0000000..5583e32
--- /dev/null
+++ b/src/sipsess/timer.c
@@ -0,0 +1,393 @@
+/**
+ * @file sipsess/timer.c  SIP Session Timers (RFC 4028)
+ *
+ * Copyright (C) 2026 BaresipKit contributors
+ */
+#include <re_types.h>
+#include <re_mem.h>
+#include <re_mbuf.h>
+#include <re_sa.h>
+#include <re_list.h>
+#include <re_hash.h>
+#include <re_fmt.h>
+#include <re_uri.h>
+#include <re_tmr.h>
+#include <re_msg.h>
+#include <re_sip.h>
+#include <re_sipsess.h>
+#include "sipsess.h"
+
+
+enum {
+	TIMER_RETRY_MS = 1000,
+	TIMER_BYE_MARGIN = 32,
+};
+
+
+static void refresh_handler(void *arg);
+
+
+static void expire_handler(void *arg)
+{
+	struct sipsess *sess = arg;
+
+	sipsess_terminate(sess, ETIMEDOUT, NULL);
+}
+
+
+static uint64_t expiry_delay(uint32_t interval)
+{
+	return (uint64_t)(interval - MIN(TIMER_BYE_MARGIN, interval / 3))
+		* 1000;
+}
+
+
+static bool refresh_busy(const struct sipsess *sess)
+{
+	return !sess->established || sess->req || sess->replyl.head
+		|| sess->requestl.head || sess->modify_pending
+		|| sess->tmr.th || sess->neg_state != SDP_NEG_DONE;
+}
+
+
+static uint64_t until_deadline(const struct sipsess *sess)
+{
+	uint64_t now = tmr_jiffies();
+
+	return sess->st_deadline > now ? sess->st_deadline - now : 0;
+}
+
+
+static void refresh_handler(void *arg)
+{
+	struct sipsess *sess = arg;
+	uint64_t left;
+	int err = EBUSY;
+
+	if (sess->terminated || !sess->st_interval)
+		return;
+
+	left = until_deadline(sess);
+	if (!left) {
+		expire_handler(sess);
+		return;
+	}
+
+	if (!refresh_busy(sess)) {
+		if (sess->st_peer_update)
+			err = sipsess_update_refresh(sess);
+		else
+			err = sipsess_reinvite(sess, true);
+	}
+
+	if (err)
+		tmr_start(&sess->st_tmr, MIN(TIMER_RETRY_MS, left),
+			  refresh_handler, sess);
+	else
+		tmr_start(&sess->st_tmr, left, expire_handler, sess);
+}
+
+
+static bool supports_timer(const struct sip_msg *msg)
+{
+	return sip_msg_hdr_has_value(msg, SIP_HDR_SUPPORTED, "timer")
+		|| sip_msg_hdr_has_value(msg, SIP_HDR_REQUIRE, "timer");
+}
+
+
+static uint32_t session_expires(const struct sip_msg *msg,
+				struct pl *refresher)
+{
+	const struct sip_hdr *hdr;
+	struct pl delta;
+
+	*refresher = pl_null;
+
+	hdr = sip_msg_hdr(msg, SIP_HDR_SESSION_EXPIRES);
+	if (!hdr)
+		return 0;
+
+	if (re_regex(hdr->val.p, hdr->val.l, "[0-9]+", &delta))
+		return 0;
+
+	(void)msg_param_decode(&hdr->val, "refresher", refresher);
+
+	return pl_u32(&delta);
+}
+
+
+static void peer_methods(struct sipsess *sess, const struct sip_msg *msg)
+{
+	if (sip_msg_hdr(msg, SIP_HDR_ALLOW))
+		sess->st_peer_update =
+			sip_msg_hdr_has_value(msg, SIP_HDR_ALLOW, "UPDATE");
+}
+
+
+/**
+ * Start the refresh or the expiry timer for the negotiated interval
+ *
+ * @param sess SIP Session
+ */
+void sipsess_timer_start(struct sipsess *sess)
+{
+	if (!sess || sess->terminated || !sess->st_interval) {
+		if (sess)
+			tmr_cancel(&sess->st_tmr);
+		return;
+	}
+
+	sess->st_deadline = tmr_jiffies() + expiry_delay(sess->st_interval);
+
+	if (sess->st_refresher)
+		tmr_start(&sess->st_tmr, (uint64_t)sess->st_interval * 500,
+			  refresh_handler, sess);
+	else
+		tmr_start(&sess->st_tmr, expiry_delay(sess->st_interval),
+			  expire_handler, sess);
+}
+
+
+/**
+ * Print the session timer headers of a request this side sends
+ *
+ * @param pf   Print handler
+ * @param sess SIP Session
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int sipsess_timer_print(struct re_printf *pf, const struct sipsess *sess)
+{
+	int err;
+
+	if (!sess || !sess->st_local)
+		return 0;
+
+	err = re_hprintf(pf, "Supported: timer\r\n");
+
+	if (sess->established && !sess->st_interval)
+		return err;
+
+	if (sess->established)
+		err |= re_hprintf(pf, "Session-Expires: %u;refresher=%s\r\n",
+				  sess->st_interval,
+				  sess->st_refresher ? "uac" : "uas");
+	else
+		err |= re_hprintf(pf, "Session-Expires: %u\r\n",
+				  sess->st_local);
+
+	if (sess->st_min_se)
+		err |= re_hprintf(pf, "Min-SE: %u\r\n", sess->st_min_se);
+
+	return err;
+}
+
+
+/**
+ * Print the session timer headers of a 2xx this side sends
+ *
+ * @param pf   Print handler
+ * @param sess SIP Session
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int sipsess_timer_print_reply(struct re_printf *pf,
+			      const struct sipsess *sess)
+{
+	int err;
+
+	if (!sess || !sess->st_local || !sess->st_interval)
+		return 0;
+
+	err = re_hprintf(pf, "Session-Expires: %u;refresher=%s\r\n",
+			 sess->st_interval,
+			 sess->st_refresher ? "uas" : "uac");
+
+	if (sess->st_peer_timer)
+		err |= re_hprintf(pf, "Require: timer\r\n");
+
+	return err;
+}
+
+
+/**
+ * Take the session interval and the refresher from an INVITE or UPDATE
+ * that this side answers
+ *
+ * @param sess SIP Session
+ * @param msg  Received request
+ */
+void sipsess_timer_request(struct sipsess *sess, const struct sip_msg *msg)
+{
+	struct pl refresher;
+	uint32_t interval;
+
+	if (!sess || !msg || !sess->st_local)
+		return;
+
+	peer_methods(sess, msg);
+	sess->st_peer_timer = supports_timer(msg);
+
+	interval = session_expires(msg, &refresher);
+	if (!interval) {
+		if (sess->established)
+			return;
+
+		if (!sess->st_peer_timer) {
+			sess->st_interval = 0;
+			return;
+		}
+
+		interval = sess->st_local;
+	}
+
+	sess->st_interval = interval;
+
+	if (pl_isset(&refresher))
+		sess->st_refresher = !pl_strcasecmp(&refresher, "uas");
+	else
+		sess->st_refresher = !sess->st_peer_timer;
+}
+
+
+/**
+ * Take the session interval and the refresher from a 2xx to an INVITE or
+ * UPDATE that this side sent, and start the timer
+ *
+ * @param sess SIP Session
+ * @param msg  Received 2xx response
+ */
+void sipsess_timer_response(struct sipsess *sess, const struct sip_msg *msg)
+{
+	struct pl refresher;
+	uint32_t interval;
+
+	if (!sess || !msg || !sess->st_local)
+		return;
+
+	peer_methods(sess, msg);
+
+	interval = session_expires(msg, &refresher);
+	sess->st_interval = interval;
+	sess->st_refresher = !pl_isset(&refresher)
+		|| !pl_strcasecmp(&refresher, "uac");
+
+	sipsess_timer_start(sess);
+}
+
+
+/**
+ * Answer a request whose session interval is below this side's Min-SE with
+ * 422 (Session Interval Too Small)
+ *
+ * @param sip     SIP stack
+ * @param min_se  Smallest session interval accepted, 0 to accept any
+ * @param msg     Received INVITE or UPDATE
+ *
+ * @return True if the request was answered with 422
+ */
+bool sipsess_timer_reject(struct sip *sip, uint32_t min_se,
+			  const struct sip_msg *msg)
+{
+	struct pl refresher;
+	uint32_t interval;
+
+	if (!min_se || !msg)
+		return false;
+
+	interval = session_expires(msg, &refresher);
+	if (!interval || interval >= min_se)
+		return false;
+
+	(void)sip_treplyf(NULL, NULL, sip, msg, false, 422,
+			  "Session Interval Too Small",
+			  "Min-SE: %u\r\n"
+			  "Content-Length: 0\r\n"
+			  "\r\n", min_se);
+
+	return true;
+}
+
+
+/**
+ * Raise the session interval after a 422 (Session Interval Too Small)
+ *
+ * @param sess SIP Session
+ * @param msg  Received 422 response
+ *
+ * @return True if the request should be sent again
+ */
+bool sipsess_timer_too_small(struct sipsess *sess, const struct sip_msg *msg)
+{
+	const struct sip_hdr *hdr;
+	uint32_t min_se;
+	uint32_t sent;
+
+	if (!sess || !msg || !sess->st_local)
+		return false;
+
+	hdr = sip_msg_hdr(msg, SIP_HDR_MIN_SE);
+	if (!hdr)
+		return false;
+
+	min_se = pl_u32(&hdr->val);
+	sent = sess->established && sess->st_interval ? sess->st_interval :
+		sess->st_local;
+	if (min_se <= sent)
+		return false;
+
+	sess->st_local = min_se;
+	sess->st_min_se = min_se;
+	if (sess->st_interval)
+		sess->st_interval = min_se;
+
+	return true;
+}
+
+
+/**
+ * Set the session timer of the SIP Sessions of a socket (RFC 4028)
+ *
+ * Sessions created afterwards offer the timer in their INVITE, accept it in
+ * an INVITE they answer when the caller supports it, refresh the session
+ * with UPDATE (or a re-INVITE when the peer does not allow UPDATE) when this
+ * side is the refresher, and end the session with BYE when the peer does
+ * not refresh it in time.
+ *
+ * @param sock    SIP Session socket
+ * @param expires Session interval in seconds, 0 to disable session timers
+ * @param min_se  Smallest session interval this side accepts, 0 to omit
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int sipsess_set_timer(struct sipsess_sock *sock, uint32_t expires,
+		      uint32_t min_se)
+{
+	if (!sock || (expires && min_se > expires))
+		return EINVAL;
+
+	sock->st_expires = expires;
+	sock->st_min_se = min_se;
+
+	return 0;
+}
+
+
+/**
+ * Get the negotiated session interval of a SIP Session
+ *
+ * @param sess      SIP Session
+ * @param refresher Set to true when this side refreshes the session
+ *
+ * @return Session interval in seconds, 0 when there is no session timer
+ */
+uint32_t sipsess_timer(const struct sipsess *sess, bool *refresher)
+{
+	if (!sess)
+		return 0;
+
+	if (refresher)
+		*refresher = sess->st_interval && sess->st_refresher;
+
+	return sess->st_interval;
+}
