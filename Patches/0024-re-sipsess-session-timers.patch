diff --git a/test/sipsess_timer.c b/test/sipsess_timer.c
new file mode 100644
index 0000000..88ca9c0
--- /dev/null
+++ b/test/sipsess_timer.c
@@ -0,0 +1,494 @@
+/**
+ * @file sipsess_timer.c  SIP Session Timers (RFC 4028) testcode
+ *
+ * Copyright (C) 2026 BaresipKit contributors
+ */
+#include <string.h>
+#include <re.h>
+#include "test.h"
+
+#define DEBUG_MODULE "test_sipsess_timer"
+#define DEBUG_LEVEL 5
+#include <re_dbg.h>
+
+
+enum {
+	TIMER_INTERVAL = 2,
+	TIMER_MIN_SE   = 1,
+	RAW_MIN_SE     = 5,
+};
+
+
+struct timer_test;
+
+struct timer_peer {
+	struct timer_test *test;
+	struct sip *sip;
+	struct sipsess_sock *sock;
+	struct sip_lsnr *lsnr;
+	struct sipsess *sess;
+	struct sa laddr;
+	unsigned refresh_invites;
+	unsigned refresh_updates;
+	int close_err;
+	bool closed;
+	bool estab;
+};
+
+
+struct timer_test {
+	struct timer_peer a;
+	struct timer_peer b;
+	struct tmr stop;
+	struct tmr cut;
+	const char *answer_hdrs;
+	uint32_t seen_se;
+	uint32_t b_min_se;
+	bool raw_b;
+	bool cut_a;
+	int err;
+};
+
+
+static const char sdp[] = "v=0\r\n"
+			  "o=- 1 1 IN IP4 127.0.0.1\r\n"
+			  "s=-\r\n"
+			  "c=IN IP4 127.0.0.1\r\n"
+			  "t=0 0\r\n"
+			  "m=audio 49170 RTP/AVP 0\r\n"
+			  "a=rtpmap:0 PCMU/8000\r\n"
+			  "a=sendrecv\r\n";
+
+
+static void stop_handler(void *arg)
+{
+	(void)arg;
+	re_cancel();
+}
+
+
+static void exit_handler(void *arg)
+{
+	(void)arg;
+}
+
+
+static int make_sdp(struct mbuf **descp)
+{
+	struct mbuf *desc = mbuf_alloc(sizeof(sdp));
+	int err;
+
+	if (!desc)
+		return ENOMEM;
+
+	err = mbuf_write_str(desc, sdp);
+	mbuf_set_pos(desc, 0);
+
+	if (err)
+		mem_deref(desc);
+	else
+		*descp = desc;
+
+	return err;
+}
+
+
+static int desc_handler(struct mbuf **descp, const struct sa *src,
+			const struct sa *dst, void *arg)
+{
+	(void)src;
+	(void)dst;
+	(void)arg;
+
+	return make_sdp(descp);
+}
+
+
+static int offer_handler(struct mbuf **descp, const struct sip_msg *msg,
+			 void *arg)
+{
+	(void)msg;
+	(void)arg;
+
+	return make_sdp(descp);
+}
+
+
+static int answer_handler(const struct sip_msg *msg, void *arg)
+{
+	(void)msg;
+	(void)arg;
+
+	return 0;
+}
+
+
+static void cut_handler(void *arg)
+{
+	struct timer_test *test = arg;
+
+	sip_transp_flush(test->a.sip);
+}
+
+
+static void estab_handler(const struct sip_msg *msg, void *arg)
+{
+	struct timer_peer *peer = arg;
+	struct timer_test *test = peer->test;
+	(void)msg;
+
+	peer->estab = true;
+
+	if (peer == &test->a && test->cut_a)
+		tmr_start(&test->cut, 100, cut_handler, test);
+}
+
+
+static void close_handler(int err, const struct sip_msg *msg, void *arg)
+{
+	struct timer_peer *peer = arg;
+
+	peer->closed = true;
+	peer->close_err = err ? err : (msg ? (int)msg->scode : 0);
+}
+
+
+static uint32_t session_expires(const struct sip_msg *msg)
+{
+	const struct sip_hdr *hdr = sip_msg_hdr(msg,
+						SIP_HDR_SESSION_EXPIRES);
+
+	return hdr ? pl_u32(&hdr->val) : 0;
+}
+
+
+static bool raw_invite(struct timer_test *test, const struct sip_msg *msg)
+{
+	uint32_t se = session_expires(msg);
+
+	if (se < RAW_MIN_SE) {
+		(void)sip_treplyf(NULL, NULL, test->b.sip, msg, false, 422,
+				  "Session Interval Too Small",
+				  "Min-SE: %u\r\n"
+				  "Content-Length: 0\r\n"
+				  "\r\n", RAW_MIN_SE);
+		return true;
+	}
+
+	test->seen_se = se;
+	(void)sip_treply(NULL, test->b.sip, msg, 486, "Busy Here");
+
+	return true;
+}
+
+
+static bool peek_handler(const struct sip_msg *msg, void *arg)
+{
+	struct timer_peer *peer = arg;
+	struct timer_test *test = peer->test;
+	bool in_dialog = pl_isset(&msg->to.tag);
+
+	if (!pl_strcmp(&msg->met, "INVITE")) {
+		if (in_dialog)
+			++peer->refresh_invites;
+		else if (peer == &test->b && test->raw_b)
+			return raw_invite(test, msg);
+	}
+	else if (!pl_strcmp(&msg->met, "UPDATE")) {
+		++peer->refresh_updates;
+	}
+
+	return false;
+}
+
+
+static void conn_handler(const struct sip_msg *msg, void *arg)
+{
+	struct timer_test *test = arg;
+	struct mbuf *desc = NULL;
+	int err;
+
+	err = make_sdp(&desc);
+	if (err)
+		goto out;
+
+	err = sipsess_accept(&test->b.sess, test->b.sock, msg, 200, "OK",
+			     REL100_DISABLED, "b", "application/sdp", desc,
+			     NULL, NULL, false, offer_handler,
+			     answer_handler, estab_handler, NULL, NULL,
+			     close_handler, &test->b, "%s",
+			     test->answer_hdrs ? test->answer_hdrs : "");
+
+ out:
+	mem_deref(desc);
+	if (err)
+		test->err = err;
+}
+
+
+static int peer_alloc(struct timer_peer *peer, struct timer_test *test,
+		      bool listen, uint32_t expires)
+{
+	int err;
+
+	peer->test = test;
+	err = sip_alloc(&peer->sip, NULL, 32, 32, 32, "retest",
+			exit_handler, NULL);
+	if (err)
+		return err;
+
+	(void)sa_set_str(&peer->laddr, "127.0.0.1", 0);
+	err = sip_transp_add(peer->sip, SIP_TRANSP_UDP, &peer->laddr);
+	err |= sip_transp_laddr(peer->sip, &peer->laddr, SIP_TRANSP_UDP,
+				NULL);
+	if (err)
+		return err;
+
+	err = sip_listen(&peer->lsnr, peer->sip, true, peek_handler, peer);
+	if (err)
+		return err;
+
+	err = sipsess_listen(&peer->sock, peer->sip, 32,
+			     listen ? conn_handler : NULL, test);
+	if (err)
+		return err;
+
+	if (!expires)
+		return 0;
+
+	return sipsess_set_timer(peer->sock, expires,
+				 peer == &test->b && test->b_min_se ?
+					 test->b_min_se : TIMER_MIN_SE);
+}
+
+
+static void peer_close(struct timer_peer *peer)
+{
+	peer->sess = mem_deref(peer->sess);
+	if (peer->sock)
+		sipsess_close_all(peer->sock);
+	peer->sock = mem_deref(peer->sock);
+	peer->lsnr = mem_deref(peer->lsnr);
+	if (peer->sip)
+		sip_close(peer->sip, true);
+	peer->sip = mem_deref(peer->sip);
+}
+
+
+static int run(struct timer_test *test, uint32_t a_expires,
+	       uint32_t b_expires, const char *offer_hdrs, uint32_t run_ms)
+{
+	char to_uri[64];
+	int err;
+
+	err = peer_alloc(&test->a, test, false, a_expires);
+	err |= peer_alloc(&test->b, test, true, b_expires);
+	if (err)
+		return err;
+
+	(void)re_snprintf(to_uri, sizeof(to_uri), "sip:b@127.0.0.1:%u",
+			  sa_port(&test->b.laddr));
+
+	err = sipsess_connect(&test->a.sess, test->a.sock, to_uri, NULL,
+			      "sip:a@127.0.0.1", "a", NULL, 0,
+			      "application/sdp", NULL, NULL, false, NULL,
+			      desc_handler, offer_handler, answer_handler,
+			      NULL, estab_handler, NULL, NULL, close_handler,
+			      &test->a, "%s", offer_hdrs ? offer_hdrs : "");
+	if (err)
+		return err;
+
+	tmr_start(&test->stop, run_ms, stop_handler, test);
+	err = re_main_timeout(run_ms + 5000);
+	tmr_cancel(&test->stop);
+	tmr_cancel(&test->cut);
+
+	return err ? err : test->err;
+}
+
+
+int test_sipsess_timer_reinvite(void)
+{
+	struct timer_test test;
+	bool refresher = false;
+	int err;
+
+	memset(&test, 0, sizeof(test));
+
+	err = run(&test, TIMER_INTERVAL, TIMER_INTERVAL, NULL, 3500);
+	TEST_ERR(err);
+
+	ASSERT_TRUE(test.a.estab);
+	ASSERT_TRUE(test.b.estab);
+	ASSERT_TRUE(!test.a.closed);
+	ASSERT_TRUE(!test.b.closed);
+	ASSERT_EQ(TIMER_INTERVAL, sipsess_timer(test.a.sess, &refresher));
+	ASSERT_TRUE(refresher);
+	ASSERT_EQ(TIMER_INTERVAL, sipsess_timer(test.b.sess, &refresher));
+	ASSERT_TRUE(!refresher);
+	ASSERT_TRUE(test.b.refresh_invites >= 2);
+	ASSERT_EQ(0, test.b.refresh_updates);
+	ASSERT_EQ(0, test.a.refresh_invites);
+
+ out:
+	peer_close(&test.a);
+	peer_close(&test.b);
+
+	return err;
+}
+
+
+int test_sipsess_timer_update(void)
+{
+	struct timer_test test;
+	bool refresher = false;
+	int err;
+
+	memset(&test, 0, sizeof(test));
+	test.answer_hdrs = "Allow: INVITE, ACK, BYE, CANCEL, UPDATE\r\n";
+
+	err = run(&test, TIMER_INTERVAL, TIMER_INTERVAL,
+		  "Allow: INVITE, ACK, BYE, CANCEL, UPDATE\r\n", 3500);
+	TEST_ERR(err);
+
+	ASSERT_TRUE(!test.a.closed);
+	ASSERT_TRUE(!test.b.closed);
+	ASSERT_EQ(TIMER_INTERVAL, sipsess_timer(test.a.sess, &refresher));
+	ASSERT_TRUE(refresher);
+	ASSERT_TRUE(test.b.refresh_updates >= 2);
+	ASSERT_EQ(0, test.b.refresh_invites);
+
+ out:
+	peer_close(&test.a);
+	peer_close(&test.b);
+
+	return err;
+}
+
+
+int test_sipsess_timer_expire(void)
+{
+	struct timer_test test;
+	bool refresher = true;
+	int err;
+
+	memset(&test, 0, sizeof(test));
+
+	err = run(&test, 0, TIMER_INTERVAL,
+		  "Supported: timer\r\n"
+		  "Session-Expires: 2;refresher=uac\r\n", 3500);
+	TEST_ERR(err);
+
+	ASSERT_TRUE(test.a.estab);
+	ASSERT_TRUE(test.b.closed);
+	ASSERT_EQ(ETIMEDOUT, test.b.close_err);
+	ASSERT_TRUE(test.a.closed);
+	ASSERT_EQ(ECONNRESET, test.a.close_err);
+	ASSERT_EQ(0, sipsess_timer(test.a.sess, NULL));
+	ASSERT_EQ(TIMER_INTERVAL, sipsess_timer(test.b.sess, &refresher));
+	ASSERT_TRUE(!refresher);
+	ASSERT_EQ(0, test.b.refresh_invites);
+
+ out:
+	peer_close(&test.a);
+	peer_close(&test.b);
+
+	return err;
+}
+
+
+int test_sipsess_timer_unsupported(void)
+{
+	struct timer_test test;
+	int err;
+
+	memset(&test, 0, sizeof(test));
+
+	err = run(&test, 0, TIMER_INTERVAL, NULL, 1500);
+	TEST_ERR(err);
+
+	ASSERT_TRUE(test.a.estab);
+	ASSERT_TRUE(test.b.estab);
+	ASSERT_TRUE(!test.b.closed);
+	ASSERT_EQ(0, sipsess_timer(test.b.sess, NULL));
+	ASSERT_EQ(0, test.a.refresh_invites + test.a.refresh_updates);
+
+ out:
+	peer_close(&test.a);
+	peer_close(&test.b);
+
+	return err;
+}
+
+
+int test_sipsess_timer_too_small(void)
+{
+	struct timer_test test;
+	int err;
+
+	memset(&test, 0, sizeof(test));
+	test.raw_b = true;
+
+	err = run(&test, TIMER_INTERVAL, 0, NULL, 1000);
+	TEST_ERR(err);
+
+	ASSERT_EQ(RAW_MIN_SE, test.seen_se);
+	ASSERT_TRUE(test.a.closed);
+	ASSERT_EQ(486, test.a.close_err);
+
+ out:
+	peer_close(&test.a);
+	peer_close(&test.b);
+
+	return err;
+}
+
+
+int test_sipsess_timer_below_min_se(void)
+{
+	struct timer_test test;
+	int err;
+
+	memset(&test, 0, sizeof(test));
+	test.b_min_se = TIMER_INTERVAL;
+
+	err = run(&test, 0, TIMER_INTERVAL,
+		  "Supported: timer\r\n"
+		  "Session-Expires: 1\r\n", 1000);
+	TEST_ERR(err);
+
+	ASSERT_TRUE(!test.b.sess);
+	ASSERT_TRUE(!test.a.estab);
+	ASSERT_TRUE(test.a.closed);
+	ASSERT_EQ(422, test.a.close_err);
+
+ out:
+	peer_close(&test.a);
+	peer_close(&test.b);
+
+	return err;
+}
+
+
+int test_sipsess_timer_refresh_fails(void)
+{
+	struct timer_test test;
+	int err;
+
+	memset(&test, 0, sizeof(test));
+	test.cut_a = true;
+
+	err = run(&test, TIMER_INTERVAL, TIMER_INTERVAL, NULL, 3500);
+	TEST_ERR(err);
+
+	ASSERT_TRUE(test.a.estab);
+	ASSERT_TRUE(test.a.closed);
+	ASSERT_EQ(ETIMEDOUT, test.a.close_err);
+	ASSERT_EQ(0, test.b.refresh_invites);
+
+ out:
+	peer_close(&test.a);
+	peer_close(&test.b);
+
+	return err;
+}
