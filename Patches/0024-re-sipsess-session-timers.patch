+/**
+ * Send an UPDATE without a body that refreshes the session (RFC 4028)
+ *
+ * @param sess      SIP Session
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int sipsess_update_refresh(struct sipsess *sess)
+{
+	struct sipsess_request *req;
+	int err;
+
+	if (!sess || sess->terminated)
+		return EINVAL;
+
