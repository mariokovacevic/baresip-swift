From 157401f624c470b9227b6839e0d6f670a8e32f98 Mon Sep 17 00:00:00 2001
From: BaresipKit <baresipkit@users.noreply.github.com>
Date: Mon, 9 Nov 2026 22:32:47 +0000
Subject: [PATCH] account: add Contact URI parameters for REGISTER

libre can add URI parameters to the Contact of a REGISTER request with
sipreg_set_contact_params(), but baresip never calls it. Add
account_set_contact_params() and account_contact_params(), apply the
value in reg_register() so that every REGISTER carries it, and add
ua_set_contact_params(), which updates the active registration clients
without an unregister and without creating them again.

A REGISTER that is sent while another one is unanswered is reported as
a failed registration when both are challenged with 401. The update is
therefore sent after the response to a pending REGISTER that baresip
started itself. The periodic refresh of libre is not visible to
baresip and is not covered.
---
 include/baresip.h |  3 +++
 src/account.c     | 39 +++++++++++++++++++++++++++++++++
 src/core.h        |  2 ++
 src/reg.c         | 55 ++++++++++++++++++++++++++++++++++++++++++++++-
 src/ua.c          | 33 ++++++++++++++++++++++++++++
 5 files changed, 131 insertions(+), 1 deletion(-)

diff --git a/include/baresip.h b/include/baresip.h
index e1d5ed2..85e8ccc 100644
--- a/include/baresip.h
+++ b/include/baresip.h
@@ -152,6 +152,8 @@ bool account_call_transfer(const struct account *acc);
 bool account_rtcp_mux(const struct account *acc);
 const char *account_extra(const struct account *acc);
 const struct list *account_custom_hdrs(const struct account *acc);
+int account_set_contact_params(struct account *acc, const char *cparams);
+const char *account_contact_params(const struct account *acc);
 int account_uri_complete_strdup(const struct account *acc, char **strp,
 				const struct pl *uri);
 int account_uri_complete(const struct account *acc, struct mbuf *buf,
@@ -986,6 +988,7 @@ int  ua_print_status(struct re_printf *pf, const struct ua *ua);
 int  ua_print_supported(struct re_printf *pf, const struct ua *ua);
 int  ua_update_account(struct ua *ua);
 int  ua_register(struct ua *ua);
+int  ua_set_contact_params(struct ua *ua, const char *cparams);
 int  ua_fallback(struct ua *ua);
 void ua_unregister(struct ua *ua);
 void ua_stop_register(struct ua *ua);
diff --git a/src/account.c b/src/account.c
index 3596684..36708c5 100644
--- a/src/account.c
+++ b/src/account.c
@@ -46,6 +46,7 @@ static void destructor(void *arg)
 	mem_deref(acc->viddisp_dev);
 	mem_deref(acc->cert);
 	mem_deref(acc->extra);
+	mem_deref(acc->cparams);
 	mem_deref(acc->uas_user);
 	mem_deref(acc->uas_pass);
 	list_flush(&acc->custom_hdrs);
@@ -1961,6 +1962,44 @@ const struct list *account_custom_hdrs(const struct account *acc)
 }
 
 
+/**
+ * Set Contact URI parameters that are added to the Contact header of
+ * REGISTER requests. The string must be a pre-formatted list of
+ * "name=value" pairs separated by ';' without a leading ';'.
+ * The parameters are applied on the next (re-)registration.
+ *
+ * @param acc     User-Agent account
+ * @param cparams Contact URI parameters, NULL to clear
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int account_set_contact_params(struct account *acc, const char *cparams)
+{
+	if (!acc)
+		return EINVAL;
+
+	acc->cparams = mem_deref(acc->cparams);
+
+	if (str_isset(cparams))
+		return str_dup(&acc->cparams, cparams);
+
+	return 0;
+}
+
+
+/**
+ * Get the Contact URI parameters of an account
+ *
+ * @param acc User-Agent account
+ *
+ * @return Contact URI parameters or NULL
+ */
+const char *account_contact_params(const struct account *acc)
+{
+	return acc ? acc->cparams : NULL;
+}
+
+
 /**
  * Auto complete a SIP uri, add scheme and domain if missing
  *
diff --git a/src/core.h b/src/core.h
index c22060e..41c70b2 100644
--- a/src/core.h
+++ b/src/core.h
@@ -87,6 +87,7 @@ struct account {
 	char *viddisp_dev;
 	uint32_t autelev_pt;         /**< Payload type for telephone-events  */
 	char *extra;                 /**< Extra parameters                   */
+	char *cparams;               /**< Contact URI parameters (REGISTER)  */
 	char *uas_user;              /**< UAS authentication username        */
 	char *uas_pass;              /**< UAS authentication password        */
 	bool rtcp_mux;               /**< RTCP multiplexing                  */
@@ -230,6 +231,7 @@ int  reg_add(struct list *lst, struct ua *ua, int regid);
 int  reg_register(struct reg *reg, const char *reg_uri,
 		    const char *params, uint32_t regint, const char *outbound);
 void reg_unregister(struct reg *reg);
+int  reg_set_contact_params(struct reg *reg, const char *cparams);
 void reg_stop(struct reg *reg);
 bool reg_isok(const struct reg *reg);
 bool reg_failed(const struct reg *reg);
diff --git a/src/reg.c b/src/reg.c
index 2ce1d71..a0d653a 100644
--- a/src/reg.c
+++ b/src/reg.c
@@ -19,6 +19,8 @@ struct reg {
 
 	/* status: */
 	uint16_t scode;              /**< Registration status code           */
+	bool pending;                /**< REGISTER without final response    */
+	bool resend;                 /**< Contact params changed meanwhile   */
 	char *srv;                   /**< SIP Server id                      */
 	int af;                      /**< Cached address family for SIP conn */
 
@@ -101,6 +103,17 @@ static bool contact_handler(const struct sip_hdr *hdr,
 }
 
 
+static int reg_send(struct reg *reg)
+{
+	int err;
+
+	err = sipreg_send(reg->sipreg);
+	reg->pending = !err;
+
+	return err;
+}
+
+
 static void register_handler(int err, const struct sip_msg *msg, void *arg)
 {
 	struct reg *reg = arg;
@@ -111,6 +124,10 @@ static void register_handler(int err, const struct sip_msg *msg, void *arg)
 		BEVENT_REGISTER_OK : BEVENT_FALLBACK_OK;
 	enum bevent_ev evfail = reg->regint ?
 		BEVENT_REGISTER_FAIL : BEVENT_FALLBACK_FAIL;
+	bool resend = reg->resend;
+
+	reg->pending = false;
+	reg->resend  = false;
 
 	if (err) {
 		if (reg->regint)
@@ -162,6 +179,9 @@ static void register_handler(int err, const struct sip_msg *msg, void *arg)
 			}
 		}
 
+		if (resend)
+			(void)reg_send(reg);
+
 		bevent_ua_emit(evok, reg->ua,
 			       "%u %r", msg->scode, &msg->reason);
 	}
@@ -268,6 +288,9 @@ int reg_register(struct reg *reg, const char *reg_uri, const char *params,
 	if (acc && acc->tcpsrcport)
 		sipreg_set_srcport(reg->sipreg, acc->tcpsrcport);
 
+	if (!err && acc && str_isset(acc->cparams))
+		err = sipreg_set_contact_params(reg->sipreg, acc->cparams);
+
 	if (failed)
 		sipreg_incfailc(reg->sipreg);
 
@@ -276,7 +299,35 @@ int reg_register(struct reg *reg, const char *reg_uri, const char *params,
 		return err;
 	}
 
-	return sipreg_send(reg->sipreg);
+	reg->resend = false;
+
+	return reg_send(reg);
+}
+
+
+int reg_set_contact_params(struct reg *reg, const char *cparams)
+{
+	int err;
+
+	if (!reg)
+		return EINVAL;
+
+	if (!reg->sipreg)
+		return 0;
+
+	err = sipreg_set_contact_params(reg->sipreg, cparams);
+	if (err)
+		return err;
+
+	/* a second REGISTER next to an unanswered one is reported as a
+	   failed registration when both are challenged; send it once the
+	   response has arrived */
+	if (reg->pending) {
+		reg->resend = true;
+		return 0;
+	}
+
+	return reg_send(reg);
 }
 
 
@@ -296,6 +347,8 @@ void reg_stop(struct reg *reg)
 
 	reg->sipreg = mem_deref(reg->sipreg);
 	reg->scode = 0;
+	reg->pending = false;
+	reg->resend = false;
 }
 
 
diff --git a/src/ua.c b/src/ua.c
index 4d8441c..b586e4a 100644
--- a/src/ua.c
+++ b/src/ua.c
@@ -263,6 +263,39 @@ int ua_register(struct ua *ua)
 }
 
 
+/**
+ * Update the Contact URI parameters of a User-Agent. The value is
+ * stored on the account and applied to every active registration
+ * client, which sends a REGISTER with the new Contact, after the
+ * response to a pending REGISTER if there is one. No unregister is
+ * sent and the registration client is not recreated.
+ *
+ * @param ua      User-Agent
+ * @param cparams Contact URI parameters, NULL to clear
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int ua_set_contact_params(struct ua *ua, const char *cparams)
+{
+	struct le *le;
+	int err;
+
+	if (!ua)
+		return EINVAL;
+
+	err = account_set_contact_params(ua->acc, cparams);
+	if (err)
+		return err;
+
+	for (le = ua->regl.head; le; le = le->next) {
+		err |= reg_set_contact_params(le->data,
+					      account_contact_params(ua->acc));
+	}
+
+	return err;
+}
+
+
 /**
  * Start fallback registration checks (Cisco-keep-alive) of a User-Agent. These
  * are in the sense of RFC3261 REGISTER requests with expire set to zero. A

