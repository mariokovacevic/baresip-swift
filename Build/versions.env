# Pinned upstream sources for the BaresipKit C core.
# Each entry is a git tag plus the commit the tag resolved to when it was pinned
# (libre and baresip on 2026-11-09, the others on 2026-11-06).
# The build script verifies the checked-out commit against *_COMMIT before
# building anything.

LIBRE_REPO=https://github.com/baresip/re.git
LIBRE_TAG=v4.12.0
LIBRE_COMMIT=65555dad439de9d6a81b3ee6092b9c096585249b

BARESIP_REPO=https://github.com/baresip/baresip.git
BARESIP_TAG=v4.12.0
BARESIP_COMMIT=9cfab81550acc4bd38d6580d79b45cc6eea65cd6

# librem is no longer a separate project: it was merged into libre and lives
# under re/rem (CMake option USE_REM, default ON). Nothing to pin.

OPENSSL_REPO=https://github.com/openssl/openssl.git
OPENSSL_TAG=openssl-3.5.9
OPENSSL_COMMIT=45e844fa2a14ec92d146bd8f5778ac130b6625fb

OPUS_REPO=https://github.com/xiph/opus.git
OPUS_TAG=v1.6.1
OPUS_COMMIT=22244de5a79bd1d6d623c32e72bf1954b56235be

# Optional, only when the VP8 module is enabled (MODULE_SET=full).
LIBVPX_REPO=https://github.com/webmproject/libvpx.git
LIBVPX_TAG=v1.15.2
LIBVPX_COMMIT=d168454ecd099805c675d4a98c66f4891373302a

IOS_DEPLOYMENT_TARGET=16.0
MACOS_DEPLOYMENT_TARGET=13.0
