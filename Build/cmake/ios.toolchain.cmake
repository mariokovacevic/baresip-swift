set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR arm64)

if(NOT DEFINED BARESIPKIT_SDK)
  set(BARESIPKIT_SDK iphoneos)
endif()
if(NOT DEFINED BARESIPKIT_DEPLOYMENT_TARGET)
  set(BARESIPKIT_DEPLOYMENT_TARGET 17.0)
endif()

set(CMAKE_OSX_SYSROOT ${BARESIPKIT_SDK} CACHE STRING "" FORCE)
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET ${BARESIPKIT_DEPLOYMENT_TARGET} CACHE STRING "" FORCE)

set(CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH NO)
set(CMAKE_MACOSX_BUNDLE OFF)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(HAVE_THREADS OFF CACHE BOOL "" FORCE)
set(HAVE_RESOLV OFF CACHE BOOL "" FORCE)
set(HAVE_GETIFADDRS ON CACHE BOOL "" FORCE)
