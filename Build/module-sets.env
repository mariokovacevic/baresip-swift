# Module sets for the baresip core. Select with MODULE_SET=<name> when running
# Build/build-xcframework.sh. Every module listed here ships in the baresip
# tree at the pinned version; modules marked (patched) need a patch from
# Patches/ to build for iOS.

# minimal: audio-only SIP client with Opus and G.711, ICE/TURN, SRTP/DTLS-SRTP
MODULES_minimal="account;uuid;g711;opus;l16;auconv;auresamp;audiounit;ice;turn;stun;srtp;dtls_srtp;rtcpsummary"

# default: minimal + video capture (patched avcapture), fake video, presence/MWI,
# DTMF detection, test tone and file players used by the sample app and tests
MODULES_default="${MODULES_minimal};avcapture;fakevideo;mwi;presence;in_band_dtmf;ausine;aufile;debug_cmd"

# full: default + VP8 (needs libvpx) + the AV1 wrapper. H.264 via VideoToolbox is
# provided by the BaresipKit vidtoolbox module (Phase 1 work item), not by
# upstream baresip, and is always compiled in when present.
MODULES_full="${MODULES_default};vp8"
